{
  "name": "macroflows",
  "private": true,
  "type": "module",
  "version": "0.15.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "agent:build": "pnpm exec tsc -p tools/agent/tsconfig.json",
    "agent:bundle": "pnpm run agent:release && node tools/agent/dist/tools/agent/bundle-release.js",
    "agent:e2e:linux": "pnpm run agent:build && node scripts/agent/e2e-install-linux.mjs",
    "agent:rebuild-restart:linux": "bash scripts/agent/rebuild-restart-linux.sh",
    "agent:rebuild-restart:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/agent/rebuild-reinstall.ps1",
    "agent:release": "pnpm run agent:build && node tools/agent/dist/tools/agent/build-release.js",
    "agent:run": "pnpm run agent:build && bash scripts/agent/run-linux.sh",
    "agent:setup:docker": "node scripts/agent/setup-installer.mjs --mode=docker",
    "agent:setup:native": "node scripts/agent/setup-installer.mjs --mode=native",
    "agent:setup:wine": "node scripts/agent/setup-installer.mjs --mode=wine",
    "agent:setup": "node scripts/agent/setup-installer.mjs",
    "ai:loop:doctor": "bash scripts/ai/ralph-loop-doctor.sh",
    "ai:loop:exec": "bash scripts/ai/ralph-loop-exec.sh",
    "ai:loop:input": "bash scripts/ai/ralph-loop-make-input.sh",
    "ai:loop:plan": "bash scripts/ai/ralph-loop-plan.sh",
    "ai:loop:start": "bash scripts/ai/ralph-loop-start.sh",
    "ai:loop:update": "bash scripts/ai/ralph-loop-update.sh",
    "ai:pr:feedback": "bash scripts/ai/github-pr-feedback.sh",
    "ai:skills:sync": "bash scripts/ai/sync-global-skills.sh",
    "ai:wt-implement": "bash tools/worktrees/wt-implement.sh",
    "architecture:boundary-scan": "node scripts/architecture-boundary-scan.mjs",
    "assume-unchanged": "git update-index --assume-unchanged src/app-version.json",
    "build": "pnpm run gen-app-version && vinxi build",
    "check-unused-exports-prune-strict": "ts-prune",
    "check-unused-exports-prune": "ts-prune || echo 'Warning: ts-prune found unused exports. Consider removing them to improve code quality.'",
    "check-unused-exports-strict": "ts-unused-exports .ts-unused-exports.json",
    "check-unused-exports": "ts-unused-exports .ts-unused-exports.json || echo 'Warning: Found unused exports. Consider removing them to improve code quality.'",
    "check:no-emoji": "node scripts/check-no-emoji.mjs",
    "check": "run-p flint type-check test", 
    "copilot:check": "pnpm run check 2>&1 && echo 'COPILOT: All checks passed!' || echo 'COPILOT: Some checks failed!'",
    "dev": "pnpm run gen-app-version; vinxi dev",
    "fix": "eslint . --fix --cache >/dev/null 2>&1 || exit 0",
    "flint": "pnpm run fix && pnpm run lint",
    "gen-app-version": "bash ./.scripts/gen-app-version.sh",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "i18n:enforce": "node scripts/enforce-i18n-no-hardcoded.mjs",
    "knip:files": "knip --files --no-progress",
    "knip": "knip",
    "lint:no-iife:error-smoke": "node scripts/no-iife-in-jsx-error-smoke.mjs",
    "lint": "eslint . --cache",
    "maersk:smoke:puppeteer": "node scripts/maersk-puppeteer-smoke.mjs",
    "postinstall": "npm run assume-unchanged",
    "rebuild-restart:linux": "pnpm run agent:rebuild-restart:linux",
    "start": "vinxi start",
    "supabase:gen-types": "echo '/* eslint-disable @typescript-eslint/no-redundant-type-constituents */' > src/shared/supabase/database.types.ts && yes | npx supabase gen types typescript --project-id vdkyfygjuqcxqyzzkfjo >> src/shared/supabase/database.types.ts && pnpm run fix",
    "test:playwright": "playwright test",
    "test": "vitest run",
    "tw:build": "tailwindcss -c tailwind.config.cjs -i ./src/app.css -o ./src/tailwind-build-debug.css",
    "type-check": "tsc --noEmit --skipLibCheck",
    "ui:complexity:allowlist:check": "node scripts/ui-complexity-allowlist-check.mjs",
    "ui:complexity:ci": "pnpm run ui:complexity:report && pnpm run ui:complexity:allowlist:check",
    "ui:complexity:lint:soft": "node scripts/ui-complexity-report.mjs",
    "ui:complexity:report:write": "node scripts/ui-complexity-report.mjs --write",
    "ui:complexity:report": "node scripts/ui-complexity-report.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-web": "^0.49.0",
    "@opentelemetry/context-async-hooks": "^2.1.0",
    "@opentelemetry/context-zone": "^2.1.0",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/exporter-otlp-http": "^0.26.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/instrumentation": "^0.203.0",
    "@opentelemetry/instrumentation-fetch": "^0.203.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.48.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/sdk-trace-web": "^2.0.1",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@sentry/opentelemetry": "^10.11.0",
    "@sentry/solidstart": "^10.11.0",
    "@solidjs/router": "^0.15.0",
    "@solidjs/start": "^1.1.0",
    "@supabase/supabase-js": "^2.50.0",
    "apexcharts": "^4.7.0",
    "axios": "^1.6.8",
    "axios-rate-limit": "^1.4.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "flowbite": "^3.1.2",
    "html5-qrcode": "^2.3.8",
    "solid-apexcharts": "^0.4.0",
    "solid-js": "^1.9.5",
    "solid-toast": "^0.5.0",
    "tailwind-merge": "^3.3.0",
    "vinxi": "^0.5.3",
    "zod": "^3.25.75"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tailwindcss/cli": "^4.1.8",
    "@tailwindcss/postcss": "^4.1.8",
    "@tailwindcss/vite": "^4.1.8",
    "@total-typescript/ts-reset": "^0.6.1",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/coverage-v8": "^3.2.2",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.0.43",
    "eslint": "^8.52.0",
    "eslint-config-love": "^120.0.0",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "5.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.8",
    "ts-prune": "^0.10.3",
    "ts-unused-exports": "^11.0.1",
    "typescript": "^5.3.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.2"
  }
}