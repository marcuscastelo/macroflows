{
  "name": "macroflows",
  "private": true,
  "type": "module",
  "version": "0.13.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "npm run gen-app-version && vinxi dev",
    "build": "npm run gen-app-version && vinxi build",
    "gen-app-version": "bash ./.scripts/gen-app-version.sh",
    "type-check": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "fix": "eslint . --fix --cache >/dev/null 2>&1 || exit 0",
    "lint": "eslint . --cache",
    "flint": "npm run fix && npm run lint",
    "check": "run-p flint type-check test",
    "copilot:check": "npm run check 2>&1 && echo 'COPILOT: All checks passed!' || echo 'COPILOT: Some checks failed!'",
    "tw:build": "tailwindcss -c tailwind.config.cjs -i ./src/app.css -o ./src/tailwind-build-debug.css",
    "supabase:gen-types": "echo '/* eslint-disable @typescript-eslint/no-redundant-type-constituents */' > src/shared/supabase/database.types.ts && npx supabase gen types typescript --project-id vdkyfygjuqcxqyzzkfjo >> src/shared/supabase/database.types.ts && npm run fix"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.0",
    "@solidjs/start": "^1.1.0",
    "@supabase/supabase-js": "^2.50.0",
    "apexcharts": "^4.7.0",
    "axios": "^1.6.8",
    "axios-rate-limit": "^1.4.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "flowbite": "^3.1.2",
    "html5-qrcode": "^2.3.8",
    "solid-apexcharts": "^0.4.0",
    "solid-js": "^1.9.5",
    "solid-toast": "^0.5.0",
    "tailwind-merge": "^3.3.0",
    "vinxi": "^0.5.3",
    "zod": "^3.25.75"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tailwindcss/cli": "^4.1.8",
    "@tailwindcss/postcss": "^4.1.8",
    "@tailwindcss/vite": "^4.1.8",
    "@total-typescript/ts-reset": "^0.6.1",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/coverage-v8": "^3.2.2",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.0.43",
    "eslint": "^8.52.0",
    "eslint-config-love": "^120.0.0",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "5.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.3.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.2"
  }
}